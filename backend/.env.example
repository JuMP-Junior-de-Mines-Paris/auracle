SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Rédaction des textes du CE par IA (POST /api/ce/generate). Pas de clé Gemini
# ici : chaque membre saisit la sienne dans Paramètres > Intelligence artificielle.
GEMINI_MODEL=gemini-3.5-flash
# Chiffre ces clés en base (Fernet). Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Perdre ou changer ce secret rend les clés enregistrées illisibles (chacun
# doit la ressaisir). Pour le renouveler sans casse : « nouveau,ancien ».
# Vide : enregistrer une clé répond 503, rien n'est jamais stocké en clair.
AI_KEYS_SECRET=

# Embeddings du RAG (références, CE passés) : pas encore utilisés par la génération.
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
FRONTEND_URL=http://localhost:5173
